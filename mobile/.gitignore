node_modules/
.expo/
dist/
*.log

# Generated by `npx expo prebuild` from app.json. Regenerable, large, and they
# go stale the moment a config plugin changes — so app.json stays the source of
# truth and these are never committed.
/android
/ios

# Per-machine config — see the example file beside it
.env
.env.local

# The example templates are documentation, not secrets, and a fresh clone
# is unusable without them — the README's first step copies one.
!.env.example
