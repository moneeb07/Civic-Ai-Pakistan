{
  "expo": {
    "name": "CivicAI Pakistan",
    "slug": "civicai-pakistan",
    "scheme": "civicai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "pk.civicai.app" },
    "android": {
      "package": "pk.civicai.app",
      "permissions": ["CAMERA", "ACCESS_FINE_LOCATION"]
    },
    "extra": {
      "apiBaseUrl": "http://localhost:3000"
    }
  }
}
